DATABASE_URL=postgres://cdc_replication:REPLACE@postgres.example:5432/app?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
CDC_DATABASE_NAME=app
CDC_SLOT_NAME=app_cdc
CDC_PUBLICATIONS=app_cdc_pub
NATS_URL=tls://nats.example:4222
NATS_CREDENTIALS_FILE=/run/secrets/nats.creds
NATS_TLS_CA=/run/secrets/nats-ca.pem
STREAM_NAME=APP_CDC
STREAM_SUBJECTS=cdc.app.>
STREAM_STORAGE=file
STREAM_REPLICAS=3
STREAM_MAX_AGE=168h
DUPLICATE_WINDOW=10m
DLQ_SUBJECT_PREFIX=app_cdc_dlq
DLQ_MAX_BYTES=1073741824
DLQ_INDEX_MAX_BYTES=67108864
DLQ_TIMEOUT=1m
HEALTH_ADDR=:8080
NATS_TIMEOUT=5s
CHECKPOINT_INTERVAL=1s
