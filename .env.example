DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
CDC_DATABASE_NAME=
CDC_SLOT_NAME=better_cdc_slot
CDC_PLUGIN=pgoutput
CDC_PUBLICATIONS=better_cdc_pub

# Lossless quarantine uses separate NATS resources (never cdc.>).
DLQ_SUBJECT_PREFIX=cdc_dlq
DLQ_MAX_BYTES=1073741824
DLQ_INDEX_MAX_BYTES=67108864
# DLQ_STREAM_NAME defaults to <STREAM_NAME>_DLQ
# DLQ_BUCKET defaults to <STREAM_NAME>_RECOVERY
RAW_MESSAGE_BUFFER_BYTES=67108864
PARSED_EVENT_BUFFER_BYTES=67108864
MAX_TX_BUFFER_BYTES=67108864
MAX_SPILL_BYTES=1073741824
# SPILL_DIR=/var/lib/better-cdc/spill
# NATS_CREDENTIALS_FILE=/run/secrets/nats.creds
# NATS_TLS_CA=/run/secrets/nats-ca.pem
# NATS_TLS_CERT=/run/secrets/client.pem
# NATS_TLS_KEY=/run/secrets/client-key.pem
